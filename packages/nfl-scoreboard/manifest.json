{
  "author": "Alex Frantz",
  "id": "gg.alexav.nflscoreboard",
  "name": "NFL Scoreboard",
  "description": "Live NFL scores for every game of the week: quarter, clock, possession and finals at a glance. Tap a game to open it on ESPN. Data from ESPN's public scoreboard.",
  "version": "1.1.0",
  "preview_icon": "icon.png",
  "min_app_version": "5.52",
  "min_framework_version": "1.9.0",
  "os": [
    { "platform": "windows" }
  ],
  "supported_devices": [
    { "type": "dashboard_lcd" }
  ],
  "interactive": true,
  "required_plugins": [
    "widgetbuilder.linkprovider:Url:1.0"
  ],
  "permissions": [
    { "type": "url", "domain": "site.api.espn.com", "port": 443 },
    { "type": "url", "domain": "a.espncdn.com", "port": 443 }
  ]
}
