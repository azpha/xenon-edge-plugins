{
  "author": "Alex Frantz",
  "id": "gg.alexav.neonhud",
  "name": "Neon HUD",
  "description": "A full-screen neon cyberpunk dashboard: live CPU/GPU gauges, FPS with history, now-playing music with touch controls, clock and notification counter.",
  "version": "1.0.0",
  "preview_icon": "icon.png",
  "min_app_version": "5.52",
  "min_framework_version": "1.9.0",
  "os": [
    { "platform": "windows" }
  ],
  "supported_devices": [
    { "type": "dashboard_lcd" }
  ],
  "interactive": true,
  "required_plugins": [
    "widgetbuilder.sensorsdataprovider:Sensors:1.0",
    "widgetbuilder.mediadataprovider:Media:1.1",
    "widgetbuilder.fpsdataprovider:Fps:1.0",
    "widgetbuilder.notificationsprovider:Notifications:1.0"
  ]
}
